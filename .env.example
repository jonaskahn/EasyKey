# Release configuration for `make local-dmg` and `make dmg`.
#
# Copy to .env.local (gitignored) and fill in the blanks:
#
#     cp .env.example .env.local
#
# A variable already set in your shell wins over this file, so CI and one-off
# command lines keep working exactly as before.

# Sparkle appcast feed. Matches the value already in the Xcode project.
SPARKLE_FEED_URL=https://jonaskahn.github.io/EasyKey/appcast.xml

# Sparkle EdDSA public key, baked into the app as SUPublicEDKey.
# Deliberately NOT committed: project.pbxproj must keep "$(SPARKLE_PUBLIC_ED_KEY)"
# (see Scripts/test-release-config.sh). Read it out of an installed build with
#     /usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' EasyKey.app/Contents/Info.plist
# or copy it from the sparkle-public.key that `make update-secrets` writes locally.
SPARKLE_PUBLIC_ED_KEY=

# Shown as the support link in the app.
EASYKEY_SUPPORT_URL=https://github.com/jonaskahn/EasyKey

# Shown as the privacy link in the app. No privacy page exists yet, so this is
# a stand-in — set a real HTTPS URL before a public release.
EASYKEY_PRIVACY_POLICY_URL=

# --- Required only by `make dmg` (Developer ID signing + notarization) ---
# The signed path needs these; `make local-dmg` does not. `make update-secrets`
# stages the same names as GitHub secrets for CI.
# DEVELOPER_ID_APPLICATION=
# DEVELOPMENT_TEAM=
# APPLE_ID=
# APPLE_TEAM_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
