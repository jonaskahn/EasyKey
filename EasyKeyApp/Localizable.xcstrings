     "translation.translateHint": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Translates source text. Command-Return." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dịch văn bản nguồn. Command-Return." } } } },
