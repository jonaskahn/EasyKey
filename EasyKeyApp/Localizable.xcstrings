        "en": { "stringUnit": { "state": "translated", "value": "Compatibility mode" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chế độ tương thích ứng dụng" } }
      }
    },
    "behavior.compatibilityModeEmpty": {
      "comment": "Empty state",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No applications use compatibility mode." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chưa có ứng dụng dùng chế độ tương thích." } }
      }
    },
    "behavior.compatibilityModeHint": {
      "comment": "Description",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use alternate text replacement in apps where typing does not work correctly." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Dùng cách thay thế văn bản tương thích hơn cho ứng dụng gặp lỗi khi gõ." } }
      }
    },
    "behavior.dropApplications": {
      "comment": "Drop target",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Drop applications here" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thả ứng dụng vào đây" } }
      }
    },
    "behavior.ignoredApplications": {
      "comment": "Section",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ignored applications" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ứng dụng bị bỏ qua" } }
      }
    },
    "behavior.ignoredApplicationsHint": {
      "comment": "Description",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "EasyKey passes every key through unchanged in selected applications." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Trong các ứng dụng đã chọn, EasyKey không can thiệp vào bất kỳ phím gõ nào." } }
      }
    },
    "behavior.ignoredApplicationsEmpty": {
      "comment": "Empty state",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No applications are ignored." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chưa có ứng dụng bị bỏ qua." } }
      }
    },
    "behavior.otherLanguageSupport": {
      "comment": "Toggle",
      "localizations": {
