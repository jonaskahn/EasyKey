    "translation.autoTranslateDisclosure": {
      "comment": "Translation auto-translate disclosure",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paste automatically translates. For typing, press Return." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Dán văn bản sẽ tự động dịch. Khi nhập, nhấn Enter." } } } },
