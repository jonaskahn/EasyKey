          }
        }
      }
    },
    "behavior.advancedHint": {
      "comment": "Hint",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use these only when a specific app has input problems."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng các tùy chọn này khi một ứng dụng cụ thể gặp lỗi nhập liệu."
          }
        }
      }
    },
    "help.about.easyKey": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows EasyKey version, author, project links, and a short description of the app." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hiển thị phiên bản EasyKey, tác giả, liên kết dự án và mô tả ngắn về ứng dụng." } }
      }
    },
    "help.about.interface": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Interface Language changes EasyKey menus and settings. It does not change the typing language." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ngôn ngữ giao diện đổi menu và cài đặt EasyKey, không đổi ngôn ngữ gõ." } }
      }
    },
    "help.about.maintenance": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reset Settings restores every EasyKey preference to its default value." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đặt lại cài đặt sẽ khôi phục toàn bộ tùy chọn EasyKey về mặc định." } }
      }
    },
    "help.behavior.advanced": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Step-by-step sending and keyboard-layout compatibility help typing stay reliable in apps that mishandle fast or non-standard input." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Gửi từng bước và tương thích bố cục bàn phím giúp việc gõ ổn định hơn ở những ứng dụng xử lý kém khi nhập nhanh hoặc bố cục khác thường." } }
      }
    },
    "help.behavior.appCompatibility": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keeps EasyKey active when the current macOS input source is not English." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Giữ EasyKey hoạt động khi nguồn nhập hiện tại của macOS không phải tiếng Anh." } }
      }
    },
    "help.behavior.compatibilityMode": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Selected apps use alternate text replacement. Add apps with Finder or drag them here; Remove returns them to normal handling." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ứng dụng đã chọn dùng cách thay thế văn bản tương thích hơn. Thêm từ Finder hoặc kéo vào đây; chọn Xóa để trở lại cách xử lý thông thường." } }
      }
    },
    "help.behavior.ignoredApplications": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "EasyKey leaves every key unchanged in ignored apps. Add apps with Finder or drag them here; Remove restores EasyKey processing." } },
        "vi": { "stringUnit": { "state": "translated", "value": "EasyKey giữ nguyên mọi phím gõ trong các ứng dụng bị bỏ qua. Thêm từ Finder hoặc kéo vào đây; chọn Xóa để EasyKey xử lý lại." } }
      }
    },
    "help.encoding.output": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Default Encoding chooses how Vietnamese characters are emitted, such as Unicode, combining Unicode, VNI, or legacy tables." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Bảng mã mặc định chọn cách xuất ký tự tiếng Việt như Unicode, Unicode tổ hợp, VNI hoặc bảng mã cũ." } }
      }
    },
    "help.encoding.textConverter": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "From and To select source and destination encodings. Copy transforms entered text; Clipboard converts copied text using the shortcut." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chọn bảng mã nguồn và bảng mã đích. Sao chép kết quả để chuyển phần văn bản đã nhập, hoặc dùng bảng nhớ tạm để chuyển nội dung đã sao chép." } }
      }
    },
    "help.macros.expansion": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Controls text expansion behavior. Import and Export move saved text expansions between files." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Điều khiển cách gõ tắt hoạt động. Dùng Nhập và Xuất để chuyển danh sách gõ tắt giữa các tệp." } }
      }
    },
    "help.macros.registry": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Lists saved triggers and replacement text. Each switch enables one item; Edit changes it and Add creates another." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hiển thị các từ gõ tắt và nội dung thay thế đã lưu. Dùng công tắc để bật từng mục, Sửa để thay đổi hoặc Thêm để tạo mục mới." } }
      }
    },
    "help.smartSwitch.currentApp": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows the frontmost application and whether Smart Switch saved or applied its typing preference." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hiển thị ứng dụng đang dùng và cho biết EasyKey vừa ghi nhớ hay áp dụng lựa chọn gõ." } }
      }
    },
    "help.smartSwitch.perApp": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remember per app restores its last language. Remember encoding also restores the app-specific character encoding." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ghi nhớ theo ứng dụng khôi phục ngôn ngữ gần nhất. Ghi nhớ bảng mã cũng khôi phục bảng mã riêng của ứng dụng." } }
      }
    },
    "help.smartSwitch.savedApps": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Lists remembered app preferences. Remove deletes one preference; Remove All clears the list." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hiển thị lựa chọn đã ghi nhớ cho từng ứng dụng. Chọn Xóa để bỏ một lựa chọn hoặc Xóa tất cả để xóa toàn bộ danh sách." } }
      }
    },
    "help.system.health": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows keyboard-service and Accessibility status. Available actions grant permission, resume capture, or restart the service." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hiển thị trạng thái dịch vụ bàn phím và Trợ năng. Các nút cho phép cấp quyền, tiếp tục hoặc khởi động lại dịch vụ." } }
      }
    },
    "help.system.startupMenuBar": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Launch at Login starts EasyKey automatically. Dock Icon, gray menu icon, and open-at-launch control how EasyKey appears." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mở khi đăng nhập tự chạy EasyKey. Biểu tượng Dock, menu xám và mở cài đặt khi chạy điều khiển cách EasyKey hiển thị." } }
      }
    },
    "help.system.updates": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatic checks look for new releases periodically. Check Now requests the latest version immediately." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kiểm tra tự động định kỳ tìm bản phát hành mới. Kiểm tra ngay yêu cầu phiên bản mới nhất lập tức." } }
      }
    },
    "help.typing.activeInput": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Language enables Vietnamese or pass-through English. Input Method selects Telex, Simple Telex, or VNI. The shortcut switches language globally." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ngôn ngữ chọn gõ tiếng Việt hoặc giữ nguyên bàn phím tiếng Anh. Kiểu gõ chọn Telex, Simple Telex hoặc VNI. Phím tắt dùng để đổi ngôn ngữ ở bất kỳ đâu." } }
      }
    },
    "help.typing.advanced": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Quick consonants speed up common consonants, while the temporary shortcuts let you pause spelling or the engine without leaving Vietnamese." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Gõ nhanh phụ âm giúp nhập các phụ âm quen thuộc nhanh hơn, còn các phím tắt tạm thời cho bạn tạm dừng chính tả hoặc bộ gõ mà vẫn ở tiếng Việt." } }
      }
    },
    "help.typing.options": {
      "comment": "Settings section help",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Quick Telex controls how W transforms and cycles. Modern spelling, free tone placement, invalid-word restore, Z/F/W/J, and auto-capitalization each refine how Vietnamese is typed." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Telex nhanh quyết định cách phím W biến đổi và luân phiên. Chính tả hiện đại, bỏ dấu tự do, trả lại từ gõ sai, Z/F/W/J và tự viết hoa đều tinh chỉnh cách gõ tiếng Việt." } }
      }
    },
    "system.health": {
