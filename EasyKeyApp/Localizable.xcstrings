    "language.picker.description": {
      "comment": "Interface language setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change EasyKey menus and settings without changing the typing language."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ngôn ngữ của menu và phần cài đặt, không ảnh hưởng đến ngôn ngữ gõ."
          }
        }
      }
    },
    "typing.language.description": {
      "comment": "Typing language setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Vietnamese processing or English pass-through."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn gõ tiếng Việt hoặc giữ nguyên phím khi gõ tiếng Anh."
          }
        }
      }
    },
    "typing.inputMethod.description": {
      "comment": "Input method setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Telex, Simple Telex, or VNI typing rules."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu gõ Telex, Simple Telex hoặc VNI."
          }
        }
      }
    },
    "typing.switchLanguage.description": {
      "comment": "Language shortcut setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch typing language from any application."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển ngôn ngữ gõ trong bất kỳ ứng dụng nào."
          }
        }
      }
    },
    "typing.toneStyle.description": {
      "comment": "Tone placement setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose old placement (hòa, thủy) or new placement (hoà, thuỷ) for oa, oe, and uy without a final consonant."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu cũ (hòa, thủy) hoặc kiểu mới (hoà, thuỷ) cho vần oa, oe và uy không có phụ âm cuối."
          }
        }
      }
    },
    "typing.spellCheck.description": {
      "comment": "Spell-check setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo Telex changes that do not form valid Vietnamese syllables."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ áp dụng biến đổi Telex khi âm tiết tiếng Việt hợp lệ."
          }
        }
      }
    },
    "typing.quickTelexConsonants.description": {
      "comment": "Quick Telex consonant setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable cc=ch, gg=gi, kk=kh, nn=ng, qq=qu, pp=ph, and tt=th."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật cc=ch, gg=gi, kk=kh, nn=ng, qq=qu, pp=ph và tt=th."
          }
        }
      }
    },
    "typing.restoreInvalidWord.description": {
      "comment": "Invalid word restoration setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the original keystrokes when a word is not valid Vietnamese."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự khôi phục đúng các phím đã gõ khi từ không hợp lệ trong tiếng Việt."
          }
        }
      }
    },
    "typing.standaloneW.description": {
      "comment": "Standalone W setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In full Telex, convert standalone W to ư. Simple Telex always keeps it literal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Telex đầy đủ, đổi W đứng riêng thành ư. Simple Telex luôn giữ nguyên W."
          }
        }
      }
    },
    "typing.uppercaseFirstCharacter.description": {
      "comment": "Sentence capitalization setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capitalize the first letter after a sentence boundary."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự viết hoa chữ cái đầu sau dấu kết thúc câu."
          }
        }
      }
    },
    "typing.bracketShortcuts.description": {
      "comment": "Bracket shortcut setting description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In full Telex, use [ for ơ, ] for ư, { for Ơ, and } for Ư."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Telex đầy đủ, dùng [ cho ơ, ] cho ư, { cho Ơ và } cho Ư."
          }
        }
      }
    },
    "typing.restoreWordShortcut.description": {
      "comment": "Restore-word shortcut description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the current word to exactly what you typed."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục từ hiện tại về đúng các phím bạn đã gõ."
          }
        }
      }
    },
    "encoding.defaultEncoding.description": {
      "comment": "Default output encoding setting description",
      "localizations": {
        "en": {
